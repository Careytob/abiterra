generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
  phone         String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  inquiry       inquiry[]
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model contact {
  id        Int             @id @default(autoincrement())
  email     String
  phone     String?
  inquiry   contact_inquiry
  message   String
  status    contact_status  @default(PENDING)
  createdAt DateTime        @default(now())
  firstName String
  lastName  String

  @@index([email])
  @@index([status])
}

model feature {
  id         String   @id(map: "new_feature_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar
  propertyid String   @db.Uuid
  property   property @relation(fields: [propertyid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([name])
  @@index([propertyid])
}

model image {
  id         String   @id(map: "new_image_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        String   @db.VarChar
  filepath   String?  @db.VarChar
  imagetype  String?  @db.VarChar
  createdat  DateTime @db.Timestamp(6)
  propertyid String   @db.Uuid
  ismain     Boolean? @default(false)
  property   property @relation(fields: [propertyid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ismain])
  @@index([propertyid])
}

model inquiry {
  id         String   @id(map: "new_inquiry_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message    String
  phone      String   @db.VarChar
  status     String   @db.VarChar
  createdat  DateTime @db.Timestamp(6)
  propertyid String   @db.Uuid
  userid     String   @db.VarChar
  property   property @relation(fields: [propertyid], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      User     @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status])
  @@index([propertyid])
  @@index([userid])
}

model property {
  id            String                   @id(map: "new_property_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String                   @db.VarChar
  slug          String                   @unique(map: "new_property_slug_key") @db.VarChar
  description   String
  location      String                   @db.VarChar
  price         Float
  type          String                   @db.VarChar
  availability  Boolean?                 @default(true)
  area          Float?
  bathrooms     Int
  bedrooms      Int
  bq            Int
  city          String                   @db.VarChar
  state         String                   @db.VarChar
  status        String                   @db.VarChar
  toilets       Int
  latitude      Float?
  longitude     Float?
  createdat     DateTime?                @default(now()) @db.Timestamp(6)
  updatedat     DateTime?                @default(now()) @db.Timestamp(6)
  isfeatured    Boolean?                 @default(false)
  agentid       String                   @db.VarChar
  search_vector Unsupported("tsvector")?
  feature       feature[]
  image         image[]
  inquiry       inquiry[]

  @@index([type])
  @@index([status])
  @@index([price])
  @@index([bedrooms])
  @@index([bathrooms])
  @@index([city])
  @@index([state])
  @@index([availability])
  @@index([search_vector], type: Gin)
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_resets")
}

enum inquiry_status {
  PENDING
  REVIEWED
  CONTACTED
}

enum contact_inquiry {
  BUYING
  LAND
  RENTING
  OTHER
}

enum property_type {
  SALE
  RENT
}

enum contact_status {
  PENDING
  REVIEWED
  CONTACTED
}

enum property_status {
  AVAILABLE
  PENDING
  SOLD
  RENTED
}
