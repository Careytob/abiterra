generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Existing auth models remain unchanged
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
  phone         String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  inquiry       inquiry[]
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model contact {
  id        Int             @id @default(autoincrement())
  email     String
  phone     String?
  inquiry   contact_inquiry
  message   String
  status    contact_status  @default(PENDING)
  createdAt DateTime        @default(now())
  firstName String
  lastName  String

  @@index([email])
  @@index([status])
}

model feature {
  id         Int      @id @default(autoincrement())
  name       String
  propertyId Int
  property   property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([name])
}

model image {
  id         Int      @id @default(autoincrement())
  url        String
  createdAt  DateTime @default(now())
  propertyId Int
  property   property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  isMain     Boolean  @default(false)

  @@index([propertyId])
  @@index([isMain])
}

model inquiry {
  id         Int            @id @default(autoincrement())
  message    String
  phone      String         
  status     inquiry_status @default(PENDING)
  createdAt  DateTime       @default(now())
  propertyId Int
  userId     String
  property   property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  users      User           @relation(fields: [userId], references: [id])

  @@index([propertyId])
  @@index([userId])
  @@index([status])
}

model property {
  id            Int             @id @default(autoincrement())
  title         String
  description   String
  location      String
  price         Float
  type          property_type
  availability  Boolean         @default(true)
  area          Float?          // Changed from Float to Float? to make it nullable
  bathrooms     Int
  bedrooms      Int
  bq            Int
  city          String
  state         String
  status        property_status @default(AVAILABLE)
  toilets       Int
  latitude      Float?
  longitude     Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  features      feature[]
  images        image[]
  inquiry       inquiry[]
  agentId       String
  search_vector Unsupported("tsvector")?  

  @@index([type])
  @@index([status])
  @@index([price])
  @@index([bedrooms])
  @@index([bathrooms])
  @@index([city])
  @@index([state])
  @@index([availability])
  @@index([search_vector], type: Gin)
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_resets")
}

enum inquiry_status {
  PENDING
  REVIEWED
  CONTACTED
}

enum contact_inquiry {
  BUYING
  LAND
  RENTING
  OTHER
}

enum property_type {
  SALE
  RENT
}

enum contact_status {
  PENDING
  REVIEWED
  CONTACTED
}

enum property_status {
  AVAILABLE
  PENDING
  SOLD
  RENTED
}
