# ---------------------------------------------------------------
# Copy to .env (local) or add these in your host's env settings.
# NEXT_PUBLIC_* values are inlined at BUILD time: rebuild after changing them.
# ---------------------------------------------------------------

# --- Database (PostgreSQL, e.g. Supabase) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase (storage for listing photos) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server only, never expose or commit

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""        # optional: Google sign-in
GOOGLE_CLIENT_SECRET=""

# --- Email (password reset) ---
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_SECURE="false"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Your Brand <no-reply@yourdomain.com>"

# --- Branding & market (all optional; sensible defaults apply) ---
NEXT_PUBLIC_SITE_NAME="Abiterra"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_TAGLINE="Find Your Dream Home"
NEXT_PUBLIC_SITE_DESCRIPTION=""
NEXT_PUBLIC_CURRENCY="USD"            # ISO 4217: USD, GBP, KES, AED, PHP, NGN ...
NEXT_PUBLIC_LOCALE="en-US"            # en-US, en-GB, en-KE, en-AE ...
NEXT_PUBLIC_AREA_UNIT="sqft"          # sqft | sqm
NEXT_PUBLIC_RENT_PERIOD="month"       # month | year | week
NEXT_PUBLIC_REGION_NAME=""            # e.g. "Nairobi, Kenya" (optional marketing copy)
NEXT_PUBLIC_COUNTRY_CODE=""           # e.g. KE (structured data only)
NEXT_PUBLIC_DEFAULT_LAT="40.7128"     # map centre when a listing has no coordinates
NEXT_PUBLIC_DEFAULT_LNG="-74.006"
NEXT_PUBLIC_WATERMARK_TEXT=""         # defaults to your site host

# --- Contact details shown in footer/legal pages (empty = hidden) ---
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_ADDRESS=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_TWITTER=""

# --- Legal page templates ---
NEXT_PUBLIC_LEGAL_ENTITY=""           # defaults to the site name
NEXT_PUBLIC_GOVERNING_LAW=""          # e.g. "England and Wales"

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_RENTALS="false"
NEXT_PUBLIC_SHOW_TOILETS="false"
NEXT_PUBLIC_SHOW_BQ="false"

# --- Optional ---
NEXT_PUBLIC_SENTRY_DSN=""             # error reporting disabled when empty
CANONICAL_HOST=""                     # e.g. example.com -> redirects www.example.com
